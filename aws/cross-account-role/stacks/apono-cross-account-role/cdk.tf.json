            "path": "apono-cross-account-role/IAMRolePolicyAttachment-arn:aws:iam::aws:policy--AWSResourceExplorerReadOnlyAccess",
            "uniqueId": "IAMRolePolicyAttachment-arnawsiamawspolicy--AWSResourceExplorerReadOnlyAccess"
          }
        },
        "policy_arn": "arn:aws:iam::aws:policy/AWSResourceExplorerReadOnlyAccess",
