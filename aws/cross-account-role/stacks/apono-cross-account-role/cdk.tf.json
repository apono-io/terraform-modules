  },
  "terraform": {
    "required_providers": {
      "aws": {
        "source": "aws",
        "version": "~> 6.0"
      }
    }
  },
  "variable": {
    "connectorId": [
      {
        "default": "apono-connector",
        "type": "string"
      }
    ],
    "connectorRoleArn": [
      {
        "description": "ARN of the Apono connector IAM role that is trusted to assume the created role",
        "type": "string"
      }
    ],
    "permissionsLevel": [
      {
        "default": "Read-Only (Discovery)",
        "description": "Account level permissions the connector should have: \"Read-Only (Discovery)\" (discover resources) or \"Full-Access (Manage IAM)\" (discover and manage access).",
        "type": "string",
        "validation": [
          {
            "condition": "${contains([\"Read-Only (Discovery)\", \"Full-Access (Manage IAM)\"], var.permissionsLevel)}",
            "error_message": "permissionsLevel must be \"Read-Only (Discovery)\" or \"Full-Access (Manage IAM)\"."
          }
        ]
      }
    ],
    "tags": [
      {
        "default": {
        },
        "description": "Map of tags for the created resources",
        "type": "map(string)"
      }
    ]
  }
}