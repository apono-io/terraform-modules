        "name": "read-resource-tags-policy",
        "policy": "${jsonencode({\"Statement\" = [{\"Action\" = \"tag:GetResources\", \"Effect\" = \"Allow\", \"Resource\" = \"*\"}], \"Version\" = \"2012-10-17\"})}",
        "role": "${aws_iam_role.IAMRole.id}"
      },
      "ReadOnlyIAMRolePolicy-s3-list-policy": {
        "//": {
          "metadata": {
            "path": "apono-cross-account-role/ReadOnlyIAMRolePolicy-s3-list-policy",
            "uniqueId": "ReadOnlyIAMRolePolicy-s3-list-policy"
          }
        },
        "count": "${(var.permissionsLevel == \"Read-Only (Discovery)\") ? 1 : 0}",
        "name": "s3-list-policy",
        "policy": "${jsonencode({\"Statement\" = [{\"Action\" = [\"s3:GetBucketTagging\", \"s3:ListAllMyBuckets\", \"s3:ListBucket\", \"s3:GetBucketLocation\"], \"Effect\" = \"Allow\", \"Resource\" = \"arn:aws:s3:::*\"}], \"Version\" = \"2012-10-17\"})}",
        "role": "${aws_iam_role.IAMRole.id}"
      },
      "ReadOnlyIAMRolePolicy-ssm-params-list-policy": {
        "//": {
          "metadata": {
            "path": "apono-cross-account-role/ReadOnlyIAMRolePolicy-ssm-params-list-policy",
            "uniqueId": "ReadOnlyIAMRolePolicy-ssm-params-list-policy"
          }
        },
        "count": "${(var.permissionsLevel == \"Read-Only (Discovery)\") ? 1 : 0}",
        "name": "ssm-params-list-policy",
        "policy": "${jsonencode({\"Statement\" = [{\"Action\" = \"ssm:GetParameters*\", \"Effect\" = \"Allow\", \"Resource\" = \"arn:aws:ssm:*:*:parameter/*\"}, {\"Action\" = \"ssm:DescribeParameters\", \"Effect\" = \"Allow\", \"Resource\" = \"*\"}], \"Version\" = \"2012-10-17\"})}",
        "role": "${aws_iam_role.IAMRole.id}"
      }
    },
    "aws_iam_role_policy_attachment": {
      "IAMRolePolicyAttachment-arnawsiamawspolicy--AWSCloudFormationReadOnlyAccess": {
        "//": {
          "metadata": {
            "path": "apono-cross-account-role/IAMRolePolicyAttachment-arn:aws:iam::aws:policy--AWSCloudFormationReadOnlyAccess",
            "uniqueId": "IAMRolePolicyAttachment-arnawsiamawspolicy--AWSCloudFormationReadOnlyAccess"
          }
        },
        "policy_arn": "arn:aws:iam::aws:policy/AWSCloudFormationReadOnlyAccess",
