{
  "//": {
    "metadata": {
      "backend": "local",
      "overrides": {
        "stack": [
          "terraform"
        ]
      },
      "stackName": "apono-connector",
      "version": "0.21.0"
    },
    "outputs": {
      "apono-connector": {
        "connector_role_arn": "connector_role_arn",
        "log_group_arn": "log_group_arn"
      }
    }
  },
  "data": {
    "aws_caller_identity": {
      "caller_identity": {
        "//": {
          "metadata": {
            "path": "apono-connector/caller_identity",
            "uniqueId": "caller_identity"
          }
        }
      }
    },
    "aws_region": {
      "region": {
        "//": {
          "metadata": {
            "path": "apono-connector/region",
            "uniqueId": "region"
          }
        }
      }
    }
  },
  "output": {
    "connector_role_arn": {
      "value": "${aws_iam_role.IAMRole.arn}"
    },
    "log_group_arn": {
      "value": "${aws_cloudwatch_log_group.LogsLogGroup.arn}"
    }
  },
  "resource": {
    "aws_cloudwatch_log_group": {
      "LogsLogGroup": {
        "//": {
          "metadata": {
            "path": "apono-connector/LogsLogGroup",
            "uniqueId": "LogsLogGroup"
          }
        },
        "name": "/ecs/apono-connector-logs-${random_id.stackId.id}",
        "retention_in_days": "${var.logGroupRetentionInDays}",
        "tags": "${var.tags}"
      }
    },
    "aws_ecs_cluster": {
      "ECSCluster": {
        "//": {
          "metadata": {
            "path": "apono-connector/ECSCluster",
            "uniqueId": "ECSCluster"
          }
        },
        "name": "apono-connector-ecscluster-${random_id.stackId.id}",
        "tags": "${var.tags}"
      }
    },
    "aws_ecs_cluster_capacity_providers": {
      "EcsClusterCapacityProvider": {
        "//": {
          "metadata": {
            "path": "apono-connector/EcsClusterCapacityProvider",
            "uniqueId": "EcsClusterCapacityProvider"
          }
        },
        "capacity_providers": [
          "FARGATE",
          "FARGATE_SPOT"
        ],
        "cluster_name": "${aws_ecs_cluster.ECSCluster.name}"
      }
    },
    "aws_ecs_service": {
      "ECSService": {
        "//": {
          "metadata": {
            "path": "apono-connector/ECSService",
            "uniqueId": "ECSService"
          }
        },
        "cluster": "${aws_ecs_cluster.ECSCluster.arn}",
        "depends_on": [
          "aws_iam_role_policy.EcsTaskExecutionIAMRolePolicy",
          "aws_secretsmanager_secret_version.ECSImageCredentialsVersion",
          "aws_secretsmanager_secret_version.AponoTokenSecretVersion",
          "aws_secretsmanager_secret_version.OnepasswordConfigSecretVersion"
        ],
        "deployment_circuit_breaker": {
          "enable": false,
          "rollback": false
        },
        "deployment_maximum_percent": 100,
        "deployment_minimum_healthy_percent": 0,
        "desired_count": "${var.numberOfInstances}",
        "launch_type": "FARGATE",
        "name": "apono-connector-ecsservice-${random_id.stackId.id}",
        "network_configuration": {
          "assign_public_ip": "${var.assignPublicIp}",
          "security_groups": [
            "${aws_security_group.SecurityGroup.id}"
          ],
          "subnets": "${var.subnetIds}"
        },
        "platform_version": "LATEST",
        "scheduling_strategy": "REPLICA",
        "tags": "${var.tags}",
        "task_definition": "${aws_ecs_task_definition.ECSTaskDefinition.arn}",
        "wait_for_steady_state": true
      }
    },
    "aws_ecs_task_definition": {
      "ECSTaskDefinition": {
        "//": {
          "metadata": {
            "path": "apono-connector/ECSTaskDefinition",
            "uniqueId": "ECSTaskDefinition"
          }
        },
        "container_definitions": "${jsonencode([{\"name\" = \"apono-connector\", \"image\" = \"registry.apono.io/apono-connector:v1.9.0\", \"repositoryCredentials\" = {\"credentialsParameter\" = aws_secretsmanager_secret.ECSImageCredentials.arn}, \"links\" = [], \"portMappings\" = [], \"essential\" = true, \"entryPoint\" = [], \"command\" = [], \"environment\" = [{\"name\" = \"APONO_CONNECTOR_ID\", \"value\" = var.connectorId}, {\"name\" = \"APONO_URL\", \"value\" = \"api.apono.io\"}, {\"name\" = \"TEMPLATES_PATH\", \"value\" = \"/app/apono-agent-templates\"}], \"environmentFiles\" = [], \"mountPoints\" = [], \"volumesFrom\" = [], \"secrets\" = (length(join(\"\", aws_secretsmanager_secret.OnepasswordConfigSecret[*].arn)) >= 1) ? [{\"name\" = \"APONO_TOKEN\", \"valueFrom\" = aws_secretsmanager_secret.AponoTokenSecret.arn}, {\"name\" = \"ONEPASSWORD_CONFIG\", \"valueFrom\" = join(\"\", aws_secretsmanager_secret.OnepasswordConfigSecret[*].arn)}] : [{\"name\" = \"APONO_TOKEN\", \"valueFrom\" = aws_secretsmanager_secret.AponoTokenSecret.arn}], \"dependsOn\" = [], \"dnsServers\" = [], \"dnsSearchDomains\" = [], \"extraHosts\" = [], \"dockerSecurityOptions\" = [], \"ulimits\" = [], \"logConfiguration\" = {\"logDriver\" = \"awslogs\", \"options\" = {\"awslogs-group\" = aws_cloudwatch_log_group.LogsLogGroup.name, \"awslogs-region\" = data.aws_region.region.name, \"awslogs-stream-prefix\" = \"ecs\"}, \"secretOptions\" = []}, \"healthCheck\" = {\"command\" = [\"CMD-SHELL\", \"wget -q -O- http://localhost:8080/healthz\"], \"interval\" = 30, \"timeout\" = 5, \"retries\" = 3, \"startPeriod\" = 30}, \"systemControls\" = [], \"resourceRequirements\" = []}])}",
        "cpu": "1024",
        "execution_role_arn": "${aws_iam_role.EcsTaskExecutionIAMRole.arn}",
        "family": "connector-task-definition-${random_id.stackId.id}",
        "memory": "2048",
        "network_mode": "awsvpc",
        "requires_compatibilities": [
          "FARGATE"
        ],
        "tags": "${var.tags}",
        "task_role_arn": "${aws_iam_role.IAMRole.arn}"
      }
    },
    "aws_iam_role": {
      "EcsTaskExecutionIAMRole": {
        "//": {
          "metadata": {
            "path": "apono-connector/EcsTaskExecutionIAMRole",
            "uniqueId": "EcsTaskExecutionIAMRole"
          }
        },
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"1\",\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"ecs-tasks.amazonaws.com\"},\"Action\":[\"sts:AssumeRole\"]}]}",
        "max_session_duration": 3600,
        "name": "apono-connector-ecs-task-execution-role-${random_id.stackId.id}",
        "path": "/",
        "tags": "${var.tags}"
      },
      "IAMRole": {
        "//": {
          "metadata": {
            "path": "apono-connector/IAMRole",
            "uniqueId": "IAMRole"
          }
        },
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"1\",\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"ecs-tasks.amazonaws.com\"},\"Action\":[\"sts:AssumeRole\",\"sts:TagSession\"],\"Condition\":{\"ArnLike\":{\"aws:SourceArn\":[\"arn:aws:ecs:${data.aws_region.region.name}:${data.aws_caller_identity.caller_identity.account_id}:*\"]},\"StringEquals\":{\"aws:SourceAccount\":[\"${data.aws_caller_identity.caller_identity.account_id}\"]}}}]}",
        "max_session_duration": 3600,
        "name": "${coalesce(var.roleName, \"apono-connector-role-${random_id.stackId.id}\")}",
        "path": "/",
        "tags": "${var.tags}"
      }
    },
    "aws_iam_role_policy": {
      "EcsTaskExecutionIAMRolePolicy": {
        "//": {
          "metadata": {
            "path": "apono-connector/EcsTaskExecutionIAMRolePolicy",
            "uniqueId": "EcsTaskExecutionIAMRolePolicy"
          }
        },
        "name": "read-secrets-policy",
        "policy": "${jsonencode({\"Statement\" = [{\"Action\" = [\"secretsmanager:GetSecretValue\", \"secretsmanager:DescribeSecret\"], \"Effect\" = \"Allow\", \"Resource\" = (length(join(\"\", aws_secretsmanager_secret.OnepasswordConfigSecret[*].arn)) >= 1) ? [aws_secretsmanager_secret.ECSImageCredentials.arn, aws_secretsmanager_secret.AponoTokenSecret.arn, join(\"\", aws_secretsmanager_secret.OnepasswordConfigSecret[*].arn)] : [aws_secretsmanager_secret.ECSImageCredentials.arn, aws_secretsmanager_secret.AponoTokenSecret.arn]}], \"Version\" = \"2012-10-17\"})}",
        "role": "${aws_iam_role.EcsTaskExecutionIAMRole.id}"
      },
      "IAMRolePolicy-AponoConnectorLogsRead": {
        "//": {
          "metadata": {
            "path": "apono-connector/IAMRolePolicy-AponoConnectorLogsRead",
            "uniqueId": "IAMRolePolicy-AponoConnectorLogsRead"
          }
        },
        "name": "AponoConnectorLogsRead",
        "policy": "${jsonencode({\"Statement\" = [{\"Action\" = [\"logs:DescribeLogStreams\", \"logs:GetLogEvents\"], \"Effect\" = \"Allow\", \"Resource\" = \"arn:aws:logs:*:*:log-group:/ecs/apono-connector-logs-*:*\", \"Sid\" = \"AllowReadingAponoConnectorLogs\"}], \"Version\" = \"2012-10-17\"})}",
        "role": "${aws_iam_role.IAMRole.id}"
      },
      "IAMRolePolicy-apono-cloudtrail-logs-s3-access-policy": {
        "//": {
          "metadata": {
            "path": "apono-connector/IAMRolePolicy-apono-cloudtrail-logs-s3-access-policy",
            "uniqueId": "IAMRolePolicy-apono-cloudtrail-logs-s3-access-policy"
          }
        },
        "name": "apono-cloudtrail-logs-s3-access-policy",
        "policy": "${jsonencode({\"Statement\" = [{\"Action\" = \"s3:GetObject\", \"Effect\" = \"Allow\", \"Resource\" = \"arn:aws:s3:::aws-cloudtrail-logs-apono-*/*\"}], \"Version\" = \"2012-10-17\"})}",
        "role": "${aws_iam_role.IAMRole.id}"
      },
      "IAMRolePolicy-apono-tagged-keys-access-policy": {
        "//": {
          "metadata": {
            "path": "apono-connector/IAMRolePolicy-apono-tagged-keys-access-policy",
            "uniqueId": "IAMRolePolicy-apono-tagged-keys-access-policy"
          }
        },
        "name": "apono-tagged-keys-access-policy",
        "policy": "${jsonencode({\"Statement\" = [{\"Action\" = \"kms:Sign\", \"Condition\" = {\"StringEquals\" = {\"aws:ResourceTag/apono-connector-read\" = \"true\"}}, \"Effect\" = \"Allow\", \"Resource\" = \"*\"}, {\"Action\" = \"kms:Decrypt\", \"Condition\" = {\"StringEquals\" = {\"aws:ResourceTag/apono-connector-access\" = \"true\"}}, \"Effect\" = \"Allow\", \"Resource\" = \"*\"}], \"Version\" = \"2012-10-17\"})}",
        "role": "${aws_iam_role.IAMRole.id}"
      },
      "IAMRolePolicy-apono-tagged-lambda-functions-access-policy": {
        "//": {
          "metadata": {
            "path": "apono-connector/IAMRolePolicy-apono-tagged-lambda-functions-access-policy",
            "uniqueId": "IAMRolePolicy-apono-tagged-lambda-functions-access-policy"
          }
        },
        "name": "apono-tagged-lambda-functions-access-policy",
        "policy": "${jsonencode({\"Statement\" = [{\"Action\" = [\"lambda:InvokeFunction\", \"lambda:GetFunction\"], \"Condition\" = {\"StringEquals\" = {\"aws:ResourceTag/apono-connector-access\" = \"true\"}}, \"Effect\" = \"Allow\", \"Resource\" = \"arn:aws:lambda:*:*:function:*\"}], \"Version\" = \"2012-10-17\"})}",
        "role": "${aws_iam_role.IAMRole.id}"
      },
      "IAMRolePolicy-apono-tagged-secrets-access-policy": {
        "//": {
          "metadata": {
            "path": "apono-connector/IAMRolePolicy-apono-tagged-secrets-access-policy",
            "uniqueId": "IAMRolePolicy-apono-tagged-secrets-access-policy"
          }
        },
        "name": "apono-tagged-secrets-access-policy",
        "policy": "${jsonencode({\"Statement\" = [{\"Action\" = [\"secretsmanager:GetSecretValue\", \"secretsmanager:DescribeSecret\"], \"Condition\" = {\"StringEquals\" = {\"aws:ResourceTag/apono-connector-read\" = \"true\"}}, \"Effect\" = \"Allow\", \"Resource\" = \"arn:aws:secretsmanager:*:*:secret:*\"}], \"Version\" = \"2012-10-17\"})}",
        "role": "${aws_iam_role.IAMRole.id}"
      },
      "IAMRolePolicy-remote-management": {
        "//": {
          "metadata": {
            "path": "apono-connector/IAMRolePolicy-remote-management",
            "uniqueId": "IAMRolePolicy-remote-management"
          }
        },
        "name": "remote-management",
        "policy": "${jsonencode({\"Statement\" = [{\"Action\" = [\"sts:AssumeRole\", \"sts:TagSession\"], \"Effect\" = \"Allow\", \"Resource\" = \"arn:aws:iam::*:role/apono-*\", \"Sid\" = \"assume\"}], \"Version\" = \"2012-10-17\"})}",
        "role": "${aws_iam_role.IAMRole.id}"
      }
    },
    "aws_iam_role_policy_attachment": {
      "EcsTaskExecutionIAMRolePolicyAttachment": {
        "//": {
          "metadata": {
            "path": "apono-connector/EcsTaskExecutionIAMRolePolicyAttachment",
            "uniqueId": "EcsTaskExecutionIAMRolePolicyAttachment"
          }
        },
        "policy_arn": "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy",
        "role": "${aws_iam_role.EcsTaskExecutionIAMRole.id}"
      }
    },
    "aws_secretsmanager_secret": {
      "AponoTokenSecret": {
        "//": {
          "metadata": {
            "path": "apono-connector/AponoTokenSecret",
            "uniqueId": "AponoTokenSecret"
          }
        },
        "description": "Apono Connector token",
        "name": "apono-connector-token-${random_id.stackId.id}",
        "tags": "${var.tags}"
      },
      "ECSImageCredentials": {
        "//": {
          "metadata": {
            "path": "apono-connector/ECSImageCredentials",
            "uniqueId": "ECSImageCredentials"
          }
        },
        "description": "Apono Connector docker registry credentials",
        "name": "apono-connector-registry-credentials-${random_id.stackId.id}",
        "tags": "${var.tags}"
      },
      "OnepasswordConfigSecret": {
        "//": {
          "metadata": {
            "path": "apono-connector/OnepasswordConfigSecret",
            "uniqueId": "OnepasswordConfigSecret"
          }
        },
        "count": "${nonsensitive((length(var.onepasswordToken) >= 1)) ? 1 : 0}",
        "description": "Apono Connector 1Password configuration",
        "name": "apono-connector-onepassword-config-${random_id.stackId.id}",
        "recovery_window_in_days": 0,
        "tags": "${var.tags}"
      }
    },
    "aws_secretsmanager_secret_version": {
      "AponoTokenSecretVersion": {
        "//": {
          "metadata": {
            "path": "apono-connector/AponoTokenSecretVersion",
            "uniqueId": "AponoTokenSecretVersion"
          }
        },
        "secret_id": "${aws_secretsmanager_secret.AponoTokenSecret.id}",
        "secret_string_wo": "${var.aponoToken}",
        "secret_string_wo_version": "${parseint(substr(sha256(var.aponoToken), 0, 8), 16)}"
      },
      "ECSImageCredentialsVersion": {
        "//": {
          "metadata": {
            "path": "apono-connector/ECSImageCredentialsVersion",
            "uniqueId": "ECSImageCredentialsVersion"
          }
        },
        "secret_id": "${aws_secretsmanager_secret.ECSImageCredentials.id}",
        "secret_string_wo": "${jsonencode({\"username\" = \"apono\", \"password\" = var.aponoToken})}",
        "secret_string_wo_version": "${parseint(substr(sha256(jsonencode({\"username\" = \"apono\", \"password\" = var.aponoToken})), 0, 8), 16)}"
      },
      "OnepasswordConfigSecretVersion": {
        "//": {
          "metadata": {
            "path": "apono-connector/OnepasswordConfigSecretVersion",
            "uniqueId": "OnepasswordConfigSecretVersion"
          }
        },
        "count": "${nonsensitive((length(var.onepasswordToken) >= 1)) ? 1 : 0}",
        "secret_id": "${join(\"\", aws_secretsmanager_secret.OnepasswordConfigSecret[*].id)}",
        "secret_string_wo": "${jsonencode({\"token\" = var.onepasswordToken})}",
        "secret_string_wo_version": "${parseint(substr(sha256(jsonencode({\"token\" = var.onepasswordToken})), 0, 8), 16)}"
      }
    },
    "aws_security_group": {
      "SecurityGroup": {
        "//": {
          "metadata": {
            "path": "apono-connector/SecurityGroup",
            "uniqueId": "SecurityGroup"
          }
        },
        "egress": [
          {
            "cidr_blocks": [
              "0.0.0.0/0"
            ],
            "description": null,
            "from_port": 0,
            "ipv6_cidr_blocks": null,
            "prefix_list_ids": null,
            "protocol": "-1",
            "security_groups": null,
            "self": null,
            "to_port": 0
          }
        ],
        "name": "apono-connector-sg-${random_id.stackId.id}",
        "tags": "${var.tags}",
        "vpc_id": "${var.vpcId}"
      }
    },
    "random_id": {
      "stackId": {
        "//": {
          "metadata": {
            "path": "apono-connector/stackId",
            "uniqueId": "stackId"
          }
        },
        "byte_length": 8
      }
    }
  },
  "terraform": {
    "required_providers": {
      "aws": {
        "source": "aws",
        "version": "~> 6.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.1"
      }
    },
    "required_version": ">= 1.11"
  },
  "variable": {
    "aponoToken": [
      {
        "sensitive": true,
        "type": "string"
      }
    ],
    "assignPublicIp": [
      {
        "default": true,
        "description": "Assign public IP for the ECS task (needed when installed to subnet with internet gateway)",
        "type": "bool"
      }
    ],
    "connectorId": [
      {
        "default": "apono-connector",
        "type": "string"
      }
    ],
    "logGroupRetentionInDays": [
      {
        "default": 30,
        "description": "Number of days to retain log group logs",
        "type": "number"
      }
    ],
    "numberOfInstances": [
      {
        "default": 1,
        "description": "Number of connector instances",
        "type": "number"
      }
    ],
    "onepasswordToken": [
      {
        "default": "",
        "description": "Optional 1Password service account token. When provided, it is stored in AWS Secrets Manager as a write-only value (never saved in Terraform state) and injected into the connector as the ONEPASSWORD_CONFIG environment variable. A changed token takes effect when the connector task next restarts. The value must be known at plan time (a variable or data source, not an attribute of a resource created in the same apply)",
        "nullable": false,
        "sensitive": true,
        "type": "string"
      }
    ],
    "roleName": [
      {
        "default": null,
        "description": "Optional name for the connector IAM role. Defaults to apono-connector-role-<stack-id>",
        "type": "string"
      }
    ],
    "subnetIds": [
      {
        "type": "list"
      }
    ],
    "tags": [
      {
        "default": {
        },
        "description": "Map of tags for the created resources",
        "type": "map(string)"
      }
    ],
    "vpcId": [
      {
        "type": "string"
      }
    ]
  }
}