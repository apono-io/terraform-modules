{
  "//": {
    "metadata": {
      "backend": "local",
      "stackName": "apono-management-account-role",
      "version": "0.21.0"
    },
    "outputs": {
      "apono-management-account-role": {
        "role_arn": "role_arn"
      }
    }
  },
  "output": {
    "role_arn": {
      "value": "${aws_iam_role.IAMRole.arn}"
    }
  },
  "resource": {
    "aws_iam_role": {
      "IAMRole": {
        "//": {
          "metadata": {
            "path": "apono-management-account-role/IAMRole",
            "uniqueId": "IAMRole"
          }
        },
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"1\",\"Effect\":\"Allow\",\"Principal\":{\"AWS\":\"${var.connectorRoleArn}\"},\"Action\":[\"sts:AssumeRole\",\"sts:TagSession\"]}]}",
        "max_session_duration": 3600,
        "name": "${coalesce(var.roleName, \"apono-connector-role-${random_id.stackId.id}\")}",
        "path": "/",
        "tags": "${var.tags}"
      }
    },
    "aws_iam_role_policy": {
      "IAMRolePolicy-AponoConnectorLogsRead": {
        "//": {
          "metadata": {
            "path": "apono-management-account-role/IAMRolePolicy-AponoConnectorLogsRead",
            "uniqueId": "IAMRolePolicy-AponoConnectorLogsRead"
          }
        },
        "name": "AponoConnectorLogsRead",
        "policy": "${jsonencode({\"Statement\" = [{\"Action\" = [\"logs:DescribeLogStreams\", \"logs:GetLogEvents\"], \"Effect\" = \"Allow\", \"Resource\" = \"arn:aws:logs:*:*:log-group:/ecs/apono-connector-logs-*:*\", \"Sid\" = \"AllowReadingAponoConnectorLogs\"}], \"Version\" = \"2012-10-17\"})}",
        "role": "${aws_iam_role.IAMRole.id}"
      },
      "IAMRolePolicy-account-access-policy": {
        "//": {
          "metadata": {
            "path": "apono-management-account-role/IAMRolePolicy-account-access-policy",
            "uniqueId": "IAMRolePolicy-account-access-policy"
          }
        },
        "name": "account-access-policy",
        "policy": "${jsonencode({\"Statement\" = [{\"Action\" = [\"account-access:ListApplications\", \"account-access:GetApplication\", \"account-access:ListEntitlements\", \"account-access:GetEntitlement\", \"account-access:CreateEntitlement\", \"account-access:DeleteEntitlement\", \"account-access:ListTagsForResource\", \"account-access:TagResource\", \"account-access:UntagResource\"], \"Effect\" = \"Allow\", \"Resource\" = \"*\", \"Sid\" = \"accountAccess0\"}], \"Version\" = \"2012-10-17\"})}",
        "role": "${aws_iam_role.IAMRole.id}"
      },
      "IAMRolePolicy-apono-cloudtrail-logs-s3-access-policy": {
        "//": {
          "metadata": {
            "path": "apono-management-account-role/IAMRolePolicy-apono-cloudtrail-logs-s3-access-policy",
            "uniqueId": "IAMRolePolicy-apono-cloudtrail-logs-s3-access-policy"
          }
        },
        "name": "apono-cloudtrail-logs-s3-access-policy",
        "policy": "${jsonencode({\"Statement\" = [{\"Action\" = \"s3:GetObject\", \"Effect\" = \"Allow\", \"Resource\" = \"arn:aws:s3:::aws-cloudtrail-logs-apono-*/*\"}], \"Version\" = \"2012-10-17\"})}",
        "role": "${aws_iam_role.IAMRole.id}"
      },
      "IAMRolePolicy-apono-tagged-keys-access-policy": {
        "//": {
          "metadata": {
            "path": "apono-management-account-role/IAMRolePolicy-apono-tagged-keys-access-policy",
            "uniqueId": "IAMRolePolicy-apono-tagged-keys-access-policy"
          }
        },
        "name": "apono-tagged-keys-access-policy",
        "policy": "${jsonencode({\"Statement\" = [{\"Action\" = \"kms:Sign\", \"Condition\" = {\"StringEquals\" = {\"aws:ResourceTag/apono-connector-read\" = \"true\"}}, \"Effect\" = \"Allow\", \"Resource\" = \"*\"}, {\"Action\" = \"kms:Decrypt\", \"Condition\" = {\"StringEquals\" = {\"aws:ResourceTag/apono-connector-access\" = \"true\"}}, \"Effect\" = \"Allow\", \"Resource\" = \"*\"}], \"Version\" = \"2012-10-17\"})}",
        "role": "${aws_iam_role.IAMRole.id}"
      },
      "IAMRolePolicy-apono-tagged-lambda-functions-access-policy": {
        "//": {
          "metadata": {
            "path": "apono-management-account-role/IAMRolePolicy-apono-tagged-lambda-functions-access-policy",
            "uniqueId": "IAMRolePolicy-apono-tagged-lambda-functions-access-policy"
          }
        },
        "name": "apono-tagged-lambda-functions-access-policy",
        "policy": "${jsonencode({\"Statement\" = [{\"Action\" = [\"lambda:InvokeFunction\", \"lambda:GetFunction\"], \"Condition\" = {\"StringEquals\" = {\"aws:ResourceTag/apono-connector-access\" = \"true\"}}, \"Effect\" = \"Allow\", \"Resource\" = \"arn:aws:lambda:*:*:function:*\"}], \"Version\" = \"2012-10-17\"})}",
        "role": "${aws_iam_role.IAMRole.id}"
      },
      "IAMRolePolicy-apono-tagged-secrets-access-policy": {
        "//": {
          "metadata": {
            "path": "apono-management-account-role/IAMRolePolicy-apono-tagged-secrets-access-policy",
            "uniqueId": "IAMRolePolicy-apono-tagged-secrets-access-policy"
          }
        },
        "name": "apono-tagged-secrets-access-policy",
        "policy": "${jsonencode({\"Statement\" = [{\"Action\" = [\"secretsmanager:GetSecretValue\", \"secretsmanager:DescribeSecret\"], \"Condition\" = {\"StringEquals\" = {\"aws:ResourceTag/apono-connector-read\" = \"true\"}}, \"Effect\" = \"Allow\", \"Resource\" = \"arn:aws:secretsmanager:*:*:secret:*\"}], \"Version\" = \"2012-10-17\"})}",
        "role": "${aws_iam_role.IAMRole.id}"
      },
      "IAMRolePolicy-remote-management": {
        "//": {
          "metadata": {
            "path": "apono-management-account-role/IAMRolePolicy-remote-management",
            "uniqueId": "IAMRolePolicy-remote-management"
          }
        },
        "name": "remote-management",
        "policy": "${jsonencode({\"Statement\" = [{\"Action\" = [\"sts:AssumeRole\", \"sts:TagSession\"], \"Effect\" = \"Allow\", \"Resource\" = \"arn:aws:iam::*:role/apono-*\", \"Sid\" = \"assume\"}], \"Version\" = \"2012-10-17\"})}",
        "role": "${aws_iam_role.IAMRole.id}"
      },
      "IAMRolePolicy-sso-policy": {
        "//": {
          "metadata": {
            "path": "apono-management-account-role/IAMRolePolicy-sso-policy",
            "uniqueId": "IAMRolePolicy-sso-policy"
          }
        },
        "name": "sso-policy",
        "policy": "${jsonencode({\"Statement\" = [{\"Action\" = [\"organizations:ListAccounts\", \"tag:GetResources\", \"tag:GetTagValues\", \"sso:ListInstances\", \"identitystore:GetUserId\", \"identitystore:DescribeUser\", \"identitystore:DescribeGroup\", \"identitystore:ListGroupMemberships\", \"identitystore:ListGroupMembershipsForMember\", \"tag:GetTagKeys\", \"sso:TagResource\", \"sso:UntagResource\", \"sso-directory:SearchUsers\"], \"Effect\" = \"Allow\", \"Resource\" = \"*\", \"Sid\" = \"sso0\"}, {\"Action\" = [\"organizations:ListAccountsForParent\", \"sso:ListPermissionSets\", \"sso:CreateAccountAssignment\", \"sso:DescribeAccountAssignmentCreationStatus\", \"organizations:ListParents\", \"sso:DeleteAccountAssignment\", \"sso:DescribePermissionSet\", \"organizations:ListChildren\", \"sso:DescribeAccountAssignmentDeletionStatus\", \"sso:DeletePermissionSet\", \"sso:CreatePermissionSet\", \"sso:PutInlinePolicyToPermissionSet\", \"iam:CreateSAMLProvider\", \"iam:UpdateSAMLProvider\", \"iam:GetSAMLProvider\", \"sso:GetInlinePolicyForPermissionSet\", \"sso:DeleteInlinePolicyFromPermissionSet\", \"sso:ProvisionPermissionSet\", \"sso:AttachManagedPolicyToPermissionSet\", \"sso:DetachManagedPolicyFromPermissionSet\", \"sso:ListManagedPoliciesInPermissionSet\", \"sso:ListCustomerManagedPolicyReferencesInPermissionSet\", \"sso:AttachCustomerManagedPolicyReferenceToPermissionSet\", \"sso:DetachCustomerManagedPolicyReferenceFromPermissionSet\", \"sso:DescribePermissionSetProvisioningStatus\", \"sso:GetPermissionsBoundaryForPermissionSet\", \"sso:PutPermissionsBoundaryToPermissionSet\", \"sso:DeletePermissionsBoundaryFromPermissionSet\"], \"Effect\" = \"Allow\", \"Resource\" = [\"arn:aws:organizations::*:root/o-*/r-*\", \"arn:aws:organizations::*:ou/o-*/ou-*\", \"arn:aws:sso:::instance/*\", \"arn:aws:sso:::permissionSet/*/*\", \"arn:aws:iam::*:saml-provider/*\"], \"Sid\" = \"sso1\"}, {\"Action\" = [\"sso:CreateAccountAssignment\", \"sso:DeleteAccountAssignment\", \"sso:ProvisionPermissionSet\"], \"Effect\" = \"Allow\", \"Resource\" = coalescelist(formatlist(\"arn:aws:sso:::account/%s\", var.limitProvisioningToAccountIds), [\"arn:aws:sso:::account/*\"]), \"Sid\" = \"sso2\"}, {\"Action\" = [\"iam:AttachRolePolicy\", \"iam:CreateRole\", \"iam:DeleteRolePermissionsBoundary\", \"iam:PutRolePermissionsBoundary\", \"iam:PutRolePolicy\", \"iam:UpdateRole\", \"iam:UpdateRoleDescription\", \"iam:UpdateAssumeRolePolicy\"], \"Effect\" = \"Allow\", \"Resource\" = \"arn:aws:iam::*:role/aws-reserved/sso.amazonaws.com/*\", \"Sid\" = \"sso3\"}], \"Version\" = \"2012-10-17\"})}",
        "role": "${aws_iam_role.IAMRole.id}"
      }
    },
    "aws_iam_role_policy_attachment": {
      "IAMRolePolicyAttachment-arnawsiamawspolicy--AWSCloudFormationReadOnlyAccess": {
        "//": {
          "metadata": {
            "path": "apono-management-account-role/IAMRolePolicyAttachment-arn:aws:iam::aws:policy--AWSCloudFormationReadOnlyAccess",
            "uniqueId": "IAMRolePolicyAttachment-arnawsiamawspolicy--AWSCloudFormationReadOnlyAccess"
          }
        },
        "policy_arn": "arn:aws:iam::aws:policy/AWSCloudFormationReadOnlyAccess",
        "role": "${aws_iam_role.IAMRole.id}"
      },
      "IAMRolePolicyAttachment-arnawsiamawspolicy--AWSResourceExplorerReadOnlyAccess": {
        "//": {
          "metadata": {
            "path": "apono-management-account-role/IAMRolePolicyAttachment-arn:aws:iam::aws:policy--AWSResourceExplorerReadOnlyAccess",
            "uniqueId": "IAMRolePolicyAttachment-arnawsiamawspolicy--AWSResourceExplorerReadOnlyAccess"
          }
        },
        "policy_arn": "arn:aws:iam::aws:policy/AWSResourceExplorerReadOnlyAccess",
        "role": "${aws_iam_role.IAMRole.id}"
      },
      "IAMRolePolicyAttachment-arnawsiamawspolicy--SecurityAudit": {
        "//": {
          "metadata": {
            "path": "apono-management-account-role/IAMRolePolicyAttachment-arn:aws:iam::aws:policy--SecurityAudit",
            "uniqueId": "IAMRolePolicyAttachment-arnawsiamawspolicy--SecurityAudit"
          }
        },
        "policy_arn": "arn:aws:iam::aws:policy/SecurityAudit",
        "role": "${aws_iam_role.IAMRole.id}"
      }
    },
    "random_id": {
      "stackId": {
        "//": {
          "metadata": {
            "path": "apono-management-account-role/stackId",
            "uniqueId": "stackId"
          }
        },
        "byte_length": 8
      }
    }
  },
  "terraform": {
    "required_providers": {
      "aws": {
        "source": "aws",
        "version": "~> 6.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.1"
      }
    }
  },
  "variable": {
    "connectorRoleArn": [
      {
        "description": "ARN of the Apono connector IAM role that is trusted to assume the created role",
        "type": "string"
      }
    ],
    "limitProvisioningToAccountIds": [
      {
        "default": [
        ],
        "description": "AWS account IDs the connector may assign IAM Identity Center permission sets to. Empty (default) allows every account in the organization.",
        "type": "list(string)"
      }
    ],
    "roleName": [
      {
        "default": null,
        "description": "Optional name for the connector IAM role. Defaults to apono-connector-role-<stack-id>",
        "type": "string"
      }
    ],
    "tags": [
      {
        "default": {
        },
        "description": "Map of tags for the created resources",
        "type": "map(string)"
      }
    ]
  }
}