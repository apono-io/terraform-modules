  "terraform": {
    "required_providers": {
      "aws": {
        "source": "aws",
        "version": "~> 6.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.1"
      }
    }
  },
  "variable": {
    "aponoToken": [
      {
        "type": "string"
      }
    ],
    "assignPublicIp": [
      {
        "default": true,
        "description": "Assign public IP for the ECS task (needed when installed to subnet with internet gateway)",
        "type": "bool"
      }
    ],
    "connectorId": [
      {
        "default": "apono-connector",
        "type": "string"
      }
    ],
    "enableNlbSecurityGroup": [
      {
        "default": true,
        "description": "When true (default), a dedicated security group is attached to the NLB and connector ingress is restricted to that security group. When false, the NLB is created without a security group and connector ingress is open to 0.0.0.0/0 on the session audit ports (legacy behavior). The security group is attached at NLB creation time and AWS cannot add one to an existing NLB, so deployments created before this module version must either replace the NLB (terraform apply -replace='module.<name>.aws_lb.NLB', which changes its DNS name) or set this to false to keep the legacy open ingress.",
        "type": "bool"
      }
    ],
    "logGroupRetentionInDays": [
      {
        "default": 30,
        "description": "Number of days to retain log group logs",
        "type": "number"
      }
    ],
    "nlbIngressCidrs": [
      {
        "default": [
          "0.0.0.0/0"
        ],
        "description": "CIDR ranges allowed to reach the NLB on the session audit ports (10020-10024). Note: the NLB security group is attached at creation time - applying this module version to an existing deployment replaces the NLB and changes its DNS name.",
        "type": "list(string)"
      }
    ],
    "nlbScheme": [
      {
        "default": "internal",
        "description": "NLB scheme for session audit. Accepts \"internal\" or \"internet-facing\" (case-insensitive).",
        "type": "string",
        "validation": [
          {
            "condition": "${contains([\"internal\", \"internet-facing\"], lower(var.nlbScheme))}",
            "error_message": "nlbScheme must be \"internal\" or \"internet-facing\" (case-insensitive)."
          }
        ]
      }
    ],
    "nlbSubnetIds": [
      {
        "default": [
        ],
        "description": "Subnets for the NLB. Falls back to subnetIds if empty",
        "type": "list"
      }
    ],
    "numberOfInstances": [
      {
        "default": 1,
        "description": "Number of connector instances",
        "type": "number"
      }
    ],
    "roleName": [
      {
        "default": null,
        "description": "Optional name for the connector IAM role. Defaults to apono-connector-role-<stack-id>",
        "type": "string"
      }
    ],
    "subnetIds": [
      {
        "type": "list"
      }
    ],
    "tags": [
      {
        "default": {
        },
        "description": "Map of tags for the created resources",
        "type": "map(string)"
      }
    ],
    "vpcId": [
      {
        "type": "string"
      }
    ]
  }
}