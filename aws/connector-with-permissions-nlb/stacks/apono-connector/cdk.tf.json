          }
        },
        "count": "${var.enableNlbSecurityGroup ? 1 : 0}",
        "description": "Controls which sources are allowed to reach the Apono connector NLB on the session audit ports",
        "egress": [
          {
            "cidr_blocks": null,
            "description": null,
            "from_port": 10020,
            "ipv6_cidr_blocks": null,
            "prefix_list_ids": null,
            "protocol": "tcp",
            "security_groups": [
              "${aws_security_group.SecurityGroup.id}"
            ],
            "self": null,
            "to_port": 10024
          },
          {
            "cidr_blocks": null,
            "description": null,
            "from_port": 8080,
            "ipv6_cidr_blocks": null,
            "prefix_list_ids": null,
            "protocol": "tcp",
            "security_groups": [
