        "platform_version": "LATEST",
        "scheduling_strategy": "REPLICA",
        "tags": "${var.tags}",
        "task_definition": "${aws_ecs_task_definition.ECSTaskDefinition.arn}",
        "wait_for_steady_state": true
      }
    },
    "aws_ecs_task_definition": {
      "ECSTaskDefinition": {
        "//": {
          "metadata": {
            "path": "apono-connector/ECSTaskDefinition",
            "uniqueId": "ECSTaskDefinition"
          }
        },
        "container_definitions": "[{\"name\":\"apono-connector\",\"image\":\"registry.apono.io/apono-connector:v1.8.6\",\"repositoryCredentials\":{\"credentialsParameter\":\"${aws_secretsmanager_secret.ECSImageCredentials.arn}\"},\"cpu\":null,\"memory\":null,\"memoryReservation\":null,\"links\":[],\"portMappings\":[{\"containerPort\":10020,\"hostPort\":null,\"protocol\":\"tcp\"},{\"containerPort\":10021,\"hostPort\":null,\"protocol\":\"tcp\"},{\"containerPort\":10022,\"hostPort\":null,\"protocol\":\"tcp\"},{\"containerPort\":10023,\"hostPort\":null,\"protocol\":\"tcp\"},{\"containerPort\":10024,\"hostPort\":null,\"protocol\":\"tcp\"}],\"essential\":true,\"entryPoint\":[],\"command\":[],\"environment\":[{\"name\":\"APONO_CONNECTOR_ID\",\"value\":\"${var.connectorId}\"},{\"name\":\"APONO_URL\",\"value\":\"api.apono.io\"},{\"name\":\"TEMPLATES_PATH\",\"value\":\"/app/apono-agent-templates\"}],\"environmentFiles\":[],\"mountPoints\":[],\"volumesFrom\":[],\"linuxParameters\":null,\"secrets\":[{\"name\":\"APONO_TOKEN\",\"valueFrom\":\"${aws_secretsmanager_secret.AponoTokenSecret.arn}\"}],\"dependsOn\":[],\"startTimeout\":null,\"stopTimeout\":null,\"hostname\":null,\"user\":null,\"workingDirectory\":null,\"disableNetworking\":null,\"privileged\":null,\"readonlyRootFilesystem\":null,\"dnsServers\":[],\"dnsSearchDomains\":[],\"extraHosts\":[],\"dockerSecurityOptions\":[],\"interactive\":null,\"pseudoTerminal\":null,\"dockerLabels\":null,\"ulimits\":[],\"logConfiguration\":{\"logDriver\":\"awslogs\",\"options\":{\"awslogs-group\":\"${aws_cloudwatch_log_group.LogsLogGroup.name}\",\"awslogs-region\":\"${data.aws_region.region.name}\",\"awslogs-stream-prefix\":\"ecs\"},\"secretOptions\":[]},\"healthCheck\":{\"command\":[\"CMD-SHELL\",\"wget -q -O- http://localhost:8080/healthz\"],\"interval\":30,\"timeout\":5,\"retries\":3,\"startPeriod\":30},\"systemControls\":[],\"resourceRequirements\":[],\"firelensConfiguration\":null}]",
        "cpu": "1024",
        "execution_role_arn": "${aws_iam_role.EcsTaskExecutionIAMRole.arn}",
        "family": "connector-task-definition-${random_id.stackId.id}",
        "memory": "2048",
        "network_mode": "awsvpc",
        "requires_compatibilities": [
          "FARGATE"
        ],
        "tags": "${var.tags}",
        "task_role_arn": "${aws_iam_role.IAMRole.arn}"
      }
    },
    "aws_iam_role": {
      "EcsTaskExecutionIAMRole": {
        "//": {
          "metadata": {
            "path": "apono-connector/EcsTaskExecutionIAMRole",
            "uniqueId": "EcsTaskExecutionIAMRole"
          }
        },
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"1\",\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"ecs-tasks.amazonaws.com\"},\"Action\":[\"sts:AssumeRole\"]}]}",
        "max_session_duration": 3600,
        "name": "apono-connector-ecs-task-execution-role-${random_id.stackId.id}",
        "path": "/",
        "tags": "${var.tags}"
      },
      "IAMRole": {
        "//": {
          "metadata": {
            "path": "apono-connector/IAMRole",
            "uniqueId": "IAMRole"
          }
        },
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"1\",\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"ecs-tasks.amazonaws.com\"},\"Action\":[\"sts:AssumeRole\"],\"Condition\":{\"ArnLike\":{\"aws:SourceArn\":[\"arn:aws:ecs:${data.aws_region.region.name}:${data.aws_caller_identity.caller_identity.account_id}:*\"]},\"StringEquals\":{\"aws:SourceAccount\":[\"${data.aws_caller_identity.caller_identity.account_id}\"]}}}]}",
        "max_session_duration": 3600,
        "name": "${coalesce(var.roleName, \"apono-connector-role-${random_id.stackId.id}\")}",
        "path": "/",
        "tags": "${var.tags}"
      }
    },
    "aws_iam_role_policy": {
      "EcsTaskExecutionIAMRolePolicy": {
        "//": {
          "metadata": {
            "path": "apono-connector/EcsTaskExecutionIAMRolePolicy",
            "uniqueId": "EcsTaskExecutionIAMRolePolicy"
          }
        },
        "name": "read-secrets-policy",
        "policy": "{\"Statement\":[{\"Action\":[\"secretsmanager:GetSecretValue\",\"secretsmanager:DescribeSecret\"],\"Effect\":\"Allow\",\"Resource\":[\"${aws_secretsmanager_secret.ECSImageCredentials.arn}\",\"${aws_secretsmanager_secret.AponoTokenSecret.arn}\"]}],\"Version\":\"2012-10-17\"}",
        "role": "${aws_iam_role.EcsTaskExecutionIAMRole.id}"
