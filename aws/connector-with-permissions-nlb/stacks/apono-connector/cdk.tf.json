      "value": "${aws_iam_role.IAMRole.arn}"
    },
    "log_group_arn": {
      "value": "${aws_cloudwatch_log_group.LogsLogGroup.arn}"
    },
    "nlb_dns_name": {
      "value": "${aws_lb.NLB.dns_name}"
    }
  },
  "resource": {
    "aws_cloudwatch_log_group": {
      "LogsLogGroup": {
        "//": {
          "metadata": {
            "path": "apono-connector/LogsLogGroup",
            "uniqueId": "LogsLogGroup"
          }
        },
        "name": "/ecs/apono-connector-logs-${random_id.stackId.id}",
        "retention_in_days": "${var.logGroupRetentionInDays}",
        "tags": "${var.tags}"
      }
    },
    "aws_ecs_cluster": {
      "ECSCluster": {
        "//": {
          "metadata": {
            "path": "apono-connector/ECSCluster",
            "uniqueId": "ECSCluster"
          }
        },
        "name": "apono-connector-ecscluster-${random_id.stackId.id}",
        "tags": "${var.tags}"
      }
    },
    "aws_ecs_cluster_capacity_providers": {
      "EcsClusterCapacityProvider": {
        "//": {
          "metadata": {
            "path": "apono-connector/EcsClusterCapacityProvider",
            "uniqueId": "EcsClusterCapacityProvider"
          }
        },
        "capacity_providers": [
          "FARGATE",
          "FARGATE_SPOT"
        ],
        "cluster_name": "${aws_ecs_cluster.ECSCluster.name}"
      }
    },
    "aws_ecs_service": {
      "ECSService": {
        "//": {
          "metadata": {
            "path": "apono-connector/ECSService",
            "uniqueId": "ECSService"
          }
        },
        "cluster": "${aws_ecs_cluster.ECSCluster.arn}",
        "depends_on": [
          "aws_lb_listener.NLBListener10020",
          "aws_lb_listener.NLBListener10021",
          "aws_lb_listener.NLBListener10022",
          "aws_lb_listener.NLBListener10023",
          "aws_lb_listener.NLBListener10024"
        ],
        "deployment_circuit_breaker": {
          "enable": false,
          "rollback": false
        },
        "deployment_maximum_percent": 100,
        "deployment_minimum_healthy_percent": 0,
        "desired_count": "${var.numberOfInstances}",
        "launch_type": "FARGATE",
        "load_balancer": [
          {
            "container_name": "apono-connector",
            "container_port": 10020,
            "target_group_arn": "${aws_lb_target_group.NLBTargetGroup10020.arn}"
          },
          {
            "container_name": "apono-connector",
            "container_port": 10021,
            "target_group_arn": "${aws_lb_target_group.NLBTargetGroup10021.arn}"
          },
          {
            "container_name": "apono-connector",
            "container_port": 10022,
            "target_group_arn": "${aws_lb_target_group.NLBTargetGroup10022.arn}"
          },
          {
            "container_name": "apono-connector",
            "container_port": 10023,
            "target_group_arn": "${aws_lb_target_group.NLBTargetGroup10023.arn}"
          },
          {
            "container_name": "apono-connector",
            "container_port": 10024,
            "target_group_arn": "${aws_lb_target_group.NLBTargetGroup10024.arn}"
          }
        ],
        "name": "apono-connector-ecsservice-${random_id.stackId.id}",
        "network_configuration": {
          "assign_public_ip": "${var.assignPublicIp}",
          "security_groups": [
            "${aws_security_group.SecurityGroup.id}"
